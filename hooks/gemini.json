{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${extensionPath}/hooks/session-start.mjs\" gemini", "timeout": 10000 }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${extensionPath}/hooks/stop.mjs\" gemini", "timeout": 10000 }
        ]
      }
    ]
  }
}
